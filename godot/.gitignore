# Godot 4 cache & local data
.godot/

# Platform export staging
/android/

# Per-user export configuration (often has local paths)
export_presets.cfg

# GDExtension build outputs. We deliberately do NOT commit the compiled
# libdune.so/.dll or the wrapper .so/.dll — those are build artifacts,
# rebuilt from srcs/ + gdextension/ on each platform.
addons/dune/bin/

# Third-party skin assets (community Dune resources). Treated as user-local
# only — they're swappable skins, not engine deliverables.
assets/
